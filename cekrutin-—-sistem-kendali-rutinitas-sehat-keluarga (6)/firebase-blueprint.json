{
  "entities": {
    "FamilyProfile": {
      "title": "FamilyProfile",
      "description": "Akun Pengelola Utama (Family Health Manager) yang terhubung dengan Google Sign-In.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "managerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "managerEmail": { "type": "string", "minLength": 3, "maxLength": 150 },
        "city": { "type": "string", "maxLength": 100 },
        "puskesmasName": { "type": "string", "maxLength": 150 },
        "pinEnabled": { "type": "boolean" },
        "pinCode": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "activeMemberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "managerName", "managerEmail", "city", "puskesmasName", "pinEnabled", "pinCode", "activeMemberId", "createdAt", "updatedAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Sub-profil anggota keluarga (Ayah, Ibu, Anak, Lansia, Pengelola).",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["Ayah", "Ibu", "Anak", "Lansia", "Pengelola"] },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "targetWaterGlasses": { "type": "number" },
        "targetFruitVegPortions": { "type": "number" },
        "targetActivityMinutes": { "type": "number" },
        "medicalNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "role", "age", "gender", "targetWaterGlasses", "targetFruitVegPortions", "targetActivityMinutes", "medicalNote", "createdAt", "updatedAt"]
    },
    "DailyRoutineLog": {
      "title": "DailyRoutineLog",
      "description": "Log rutinitas sehat harian per anggota keluarga (air minum, buah & sayur, aktivitas mikro).",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "waterGlasses": { "type": "number" },
        "fruitPortions": { "type": "number" },
        "vegetablePortions": { "type": "number" },
        "activities": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "memberId", "date", "waterGlasses", "fruitPortions", "vegetablePortions", "activities", "updatedAt"]
    },
    "HealthCheckRecord": {
      "title": "HealthCheckRecord",
      "description": "Riwayat pemeriksaan medis (Tekanan Darah, Gula Darah, Kolesterol, IMT) dan status HBM.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recordedAt": { "type": "string", "minLength": 10, "maxLength": 40 },
        "systolic": { "type": "number" },
        "diastolic": { "type": "number" },
        "glucose": { "type": "number" },
        "glucoseType": { "type": "string", "enum": ["sewaktu", "puasa"] },
        "cholesterol": { "type": "number" },
        "weightKg": { "type": "number" },
        "heightCm": { "type": "number" },
        "bmi": { "type": "number" },
        "overallStatus": { "type": "string", "enum": ["normal", "waspada", "konsultasi"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "memberId", "recordedAt", "systolic", "diastolic", "glucose", "glucoseType", "cholesterol", "weightKg", "heightCm", "bmi", "overallStatus", "createdAt"]
    },
    "RoutineReminder": {
      "title": "RoutineReminder",
      "description": "Jadwal pengingat rutinitas harian anggota keluarga.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["air", "buah_sayur", "aktivitas", "cek_medis"] },
        "time": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "enabled": { "type": "boolean" },
        "lastTriggeredDate": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "memberId", "title", "category", "time", "enabled", "createdAt"]
    },
    "FaskesVisit": {
      "title": "FaskesVisit",
      "description": "Agenda kunjungan Puskesmas / Posbindu PTM keluarga.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "facilityName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "serviceType": { "type": "string", "minLength": 1, "maxLength": 150 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "time": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "notes": { "type": "string", "maxLength": 300 },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "memberId", "facilityName", "serviceType", "date", "time", "notes", "completed", "createdAt"]
    },
    "CertificateRecord": {
      "title": "CertificateRecord",
      "description": "E-Sertifikat kelulusan kuis edukasi PTM keluarga.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "certificateNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "recipientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "memberRole": { "type": "string", "enum": ["Ayah", "Ibu", "Anak", "Lansia", "Pengelola"] },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "issuedAt": { "type": "string", "minLength": 10, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "certificateNumber", "recipientName", "memberRole", "score", "totalQuestions", "issuedAt", "createdAt"]
    }
  },
  "firestore": {
    "/families/{userId}": {
      "schema": { "$ref": "#/entities/FamilyProfile" },
      "description": "Dokumen akun pengelola utama keluarga (Family Health Manager) milik userId."
    },
    "/families/{userId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Sub-koleksi profil anggota keluarga di bawah akun pengelola."
    },
    "/families/{userId}/routineLogs/{logId}": {
      "schema": { "$ref": "#/entities/DailyRoutineLog" },
      "description": "Sub-koleksi catatan rutinitas sehat harian keluarga."
    },
    "/families/{userId}/healthChecks/{checkId}": {
      "schema": { "$ref": "#/entities/HealthCheckRecord" },
      "description": "Sub-koleksi catatan cek kesehatan medis keluarga."
    },
    "/families/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/RoutineReminder" },
      "description": "Sub-koleksi jadwal pengingat harian keluarga."
    },
    "/families/{userId}/faskesVisits/{visitId}": {
      "schema": { "$ref": "#/entities/FaskesVisit" },
      "description": "Sub-koleksi jadwal kunjungan Puskesmas / Faskes."
    },
    "/families/{userId}/certificates/{certId}": {
      "schema": { "$ref": "#/entities/CertificateRecord" },
      "description": "Sub-koleksi E-Sertifikat edukasi PTM keluarga."
    }
  }
}
